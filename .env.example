# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# ─────────────────────────────────────────────────────────────────────────────
# LLM — Platform API keys (one per provider you want to support)
# ─────────────────────────────────────────────────────────────────────────────

# OpenRouter (multi-provider gateway — also used as legacy LLM_API_KEY fallback)
LLM_API_KEY=<your-openrouter-api-key>
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=mistralai/mistral-7b-instruct

# OpenAI (direct)
OPENAI_API_KEY=<your-openai-api-key>

# Anthropic
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Groq
GROQ_API_KEY=<your-api-key>
NVIDIA_NIM_API_KEY=<your-nvidia-nim-api-key>

# Per-million-token pricing for cost savings estimates (input tokens)
LLM_PRICE_PER_MILLION_TOKENS=0.055
LLM_PRICE_PER_MILLION_OUTPUT_TOKENS=0.165

# ─────────────────────────────────────────────────────────────────────────────
# BYOK (Bring Your Own Key) — server-side encryption secret
# ─────────────────────────────────────────────────────────────────────────────
# Used to pgp_sym_encrypt / pgp_sym_decrypt user API keys stored in Supabase.
# Generate with: openssl rand -base64 32
# NEVER expose this to the client. Rotate it to invalidate all stored keys.
KEY_ENCRYPTION_SECRET=<generate-with-openssl-rand-base64-32>

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
