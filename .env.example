# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
# Find in Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Service role key — used server-side only (never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# ─────────────────────────────────────────────────────────────────────────────
# LLM API (OpenAI-compatible — works with OpenRouter, Groq, Ollama, etc.)
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the OpenAI-compatible chat completions endpoint
# OpenRouter: https://openrouter.ai/api/v1
# Groq:       https://api.groq.com/openai/v1
# Ollama:     http://localhost:11434/v1
LLM_API_BASE_URL=https://openrouter.ai/api/v1

# API key for the LLM provider
LLM_API_KEY=<your-llm-api-key>

# Model name to use (must be available at your chosen provider)
# OpenRouter examples: mistralai/mistral-7b-instruct, meta-llama/llama-3-8b-instruct
# Groq examples:       llama3-8b-8192, mixtral-8x7b-32768
# Ollama examples:     llama3, mistral
LLM_MODEL=mistralai/mistral-7b-instruct

# Per-million-token price for cost savings estimate (in USD, input tokens)
LLM_PRICE_PER_MILLION_TOKENS=0.055

# Per-million-token price for output tokens
LLM_PRICE_PER_MILLION_OUTPUT_TOKENS=0.165

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
# Your deployment URL (used for OAuth redirects and SSR API calls)
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
